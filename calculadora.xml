<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    tools:context=".MainActivity">
   
    <TextView
        android:id="@+id/txt_expressao"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text=""
        android:textColor="@color/white"
        android:textSize="40sp"
        android:gravity="end"
        android:layout_marginEnd="10dp"
        android:ellipsize="start"
        android:singleLine="true" />


    <TextView
        android:id="@+id/txt_resultado"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text=""
        android:textColor="@color/white"
        android:textSize="30sp"
        android:gravity="end"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:maxLines="1"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/backspace"
            android:layout_width="100dp"
            android:layout_height="105dp"
            android:backgroundTint="@color/gray"
            android:gravity="center"
            app:icon="@drawable/baseline_backspace_24"
            app:iconSize="38dp"
            android:padding="29dp"
            app:iconTint="@color/white"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/bt_limpar"
            style="@style/Operators_Buttons2"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="AC"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/porcentagem"
            style="@style/Operators_Buttons2"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="%"/>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/divisao"
            style="@style/Operators_Buttons3"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="/"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_sete"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:text="7" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_oito"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="8" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_nove"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="9" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/multiplicacao"
            style="@style/Operators_Buttons3"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="X"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_quatro"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="4"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_cinco"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="5"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_seis"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="6"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/subtracao"
            style="@style/Operators_Buttons3"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="-"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_um"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_dois"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="2"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_tres"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="3"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/adicao"
            style="@style/Operators_Buttons3"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:text="+" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/modulo"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="+/-"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/numero_zero"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="0"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ponto"
            style="@style/Numbers_Button"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="."/>



        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/igual"
            style="@style/Operators_Buttons3"
            android:background="@drawable/botao_redondo"
            android:padding="0dp"
            android:layout_width="5dp"
            android:layout_height="100dp"
            android:text="="/>

    </LinearLayout>


</LinearLayout>
